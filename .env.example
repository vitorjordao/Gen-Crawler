# Active Spring profile (dev = H2 in-memory, prod = PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# --- Database (prod profile) ---
POSTGRES_DB=crawlerdb
POSTGRES_USER=crawler
POSTGRES_PASSWORD=change-me
# Override JDBC URL explicitly if not using docker-compose networking
# DATABASE_URL=jdbc:postgresql://localhost:5432/crawlerdb
# DATABASE_DRIVER=org.postgresql.Driver
# DATABASE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Hibernate schema strategy (update | validate | none)
DDL_AUTO=update

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Server ---
SERVER_PORT=8080

# --- H2 console (dev profile only) ---
H2_CONSOLE_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_LEVEL_SPRING=WARN
LOG_LEVEL_HIBERNATE=WARN
